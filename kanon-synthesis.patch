+            "protocol_version": PROTOCOL_VERSION, "source_sha256": source_digest,
+            "compiler_sha256": compiler_digest, "output_sha256": output_digest,
+            "allowed_axioms": ALLOWED_AXIOMS, "expansions": expansions, "timing": timing,
+        }
