mu N : Type 0 with
| zero : N
| succ : N -> N

def Bool : Type 0 := sum ((prod () : Type 0), (prod () : Type 0))
def yes : Bool := inj 1 of 2 ()
def no : Bool := inj 0 of 2 ()
def rec uSub : N -> N -> N := fun (n : N) (m : N) => case n as x in N return N with | zero => zero | succ p => (case m as y in N return N with | zero => n | succ q => uSub p q)
def rec observe : N -> Nat := fun (n : N) => case n as x in N return Nat with | zero => 0 | succ m => natAdd 1 (observe m)
def Unit : Type 0 := prod ()
mu Agreement : (0 a : Nat) -> (0 b : Nat) -> Type 0 with
| same : (0 a : Nat) -> Agreement a a
def n0 : N := zero
def n1 : N := succ n0
def n2 : N := succ n1
def score : Bool -> Nat := fun (b : Bool) => case b as x return Nat with | 0 (u : Unit) => 0 | 1 (u : Unit) => 1
def witness : Agreement (observe (uSub n2 n1)) (natSub 2 1) := same (observe (uSub n2 n1))
def main : Nat := natAdd (score (natEq (observe (uSub n2 n1)) 1)) (score (natEq (natSub 2 1) 1))
