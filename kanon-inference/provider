#!/bin/sh
set -eu
provider_root=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
if [ ! -x "$provider_root/.venv/bin/python" ]; then
  printf '%s\n' '{"protocol_version":1,"error":{"code":"runtime_missing","message":"Install the workspace virtual environment described in README.md."}}'
  exit 0
fi
exec "$provider_root/.venv/bin/python" -I "$provider_root/runtime.py" "$@"
